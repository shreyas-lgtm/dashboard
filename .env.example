# -----------------------------------------------------------------------------
# Verizon Account Dashboard configuration
# -----------------------------------------------------------------------------
# This dashboard does NOT connect to Verizon directly (Verizon has no public
# consumer API). It renders whatever account data you give it.

# Mode:
#   true  = use the sample account in src/mockData.ts (recommended; the default)
#   false = fetch /api/verizon (serve your own data via the ACCOUNT_JSON var)
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false and you deploy the serverless endpoint.
# Paste your account as a single line of JSON matching the VerizonAccount
# interface in src/types.ts. Leave empty to keep using mock mode.
# ACCOUNT_JSON=
