# Zoho OAuth credentials — copy to .env and fill in your values
# Get these from https://api-console.zoho.com → Self Client
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Your Zoho Organization ID (visible in any Zoho Procurement API response)
ZOHO_ORGANIZATION_ID=60068679686

# Zoho accounts domain — change to zoho.eu / zoho.in / zoho.com.au if needed
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

# Set to "true" to use mock data instead of live API (useful for local dev)
VITE_USE_MOCK=false

# --- ERPNext structure seeder (seed/) ---
# Generate the key/secret in ERPNext: My Settings → API Access → Generate Keys
FRAPPE_URL=https://yoursite.frappe.cloud
FRAPPE_API_KEY=your_api_key_here
FRAPPE_API_SECRET=your_api_secret_here
# Company name exactly as it appears in ERPNext
FRAPPE_COMPANY=My Company
# PO value (in company currency) at or below which POs skip manager approval
PO_APPROVAL_THRESHOLD=25000

# --- Parts data loader (seed/load-data.mjs) ---
# Path to your local Excel/CSV parts file (Items AND Suppliers read from it).
# Windows example: SHEET_PARTS_FILE=C:\Users\Welcome\dashboard\seed\data\parts.xlsx
SHEET_PARTS_FILE=
# OR a published-as-CSV Google Sheet link (used only if SHEET_PARTS_FILE is blank)
SHEET_PARTS_URL=
# For the full multi-tab tracker workbook: which tab + which 0-based row has the
# column headers. The Design Tracker has a band row above headers, so row 1.
SHEET_PARTS_TAB=Design Tracker
SHEET_HEADER_ROW=1
# Placeholder HSN/SAC code applied to all items (refine per-part later)
DEFAULT_HSN_CODE=84799090
# Warehouse that opening stock (Stock-in-Hand) is placed into
OPENING_STOCK_WAREHOUSE=Main Office - Stores
